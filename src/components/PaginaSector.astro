---
// Pagina de un sector (/sectores/peluquerias-y-estetica, ...). Compartida
// entre castellano e ingles. Los textos viven en data/sectores.ts; las
// etiquetas comunes en i18n (paginaSector). Misma gramatica visual que las
// paginas de servicio: portada navy, banda crema, FAQ en <details>.
import Layout from '../layouts/Layout.astro';
import Header from './Header';
import Footer from './Footer';
import CtaContacto from './CtaContacto.astro';
import { LOGOS } from './SatisfiedClients';
import { SECTORES, rutaSector } from '../data/sectores';
import { schemaFaq } from '../data/schemaFaq';
import { contenido } from '../i18n';
import { ruta, type Idioma } from '../i18n/config';

interface Props {
  idioma: Idioma;
  slug: string;
}

const { idioma, slug } = Astro.props;
const t = contenido(idioma);
const l = t.paginaSector;
const sector = SECTORES.find((s) => s.slug === slug)!;
const x = sector.texto[idioma];
const otros = SECTORES.filter((s) => s.slug !== slug);
const cliente = sector.cliente ? LOGOS.find((c) => c.id === sector.cliente && c.frase) : undefined;
const traduccion = cliente ? t.clientes.traducciones[cliente.id] : undefined;

const SITE = Astro.site ?? new URL('https://dalsats.com');
const urlPagina = new URL(ruta(rutaSector(slug), idioma), SITE).toString();

const schemaMigas = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DALSAT', item: new URL(ruta('/', idioma), SITE).toString() },
    { '@type': 'ListItem', position: 2, name: l.migas, item: new URL(ruta('/sectores', idioma), SITE).toString() },
    { '@type': 'ListItem', position: 3, name: x.nombre, item: urlPagina },
  ],
};
const schemaPreguntas = schemaFaq(x.preguntas, idioma);
---

<Layout title={x.seoTitulo} description={x.seoDescripcion}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaMigas)} />
  <script type="application/ld+json" set:html={JSON.stringify(schemaPreguntas)} />

  <Header client:load currentPath="/sectores" idioma={idioma} />

  <main id="contenido" class="pt-16">
    <section class="relative py-16 sm:py-24 bg-navy-900 overflow-hidden bg-[radial-gradient(ellipse_55%_60%_at_0%_0%,rgba(20,205,236,0.14),transparent_70%)]">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <nav aria-label={l.migas} class="mb-8 sm:mb-10 text-xs font-mono text-white/60">
          <a href={ruta('/sectores', idioma)} class="hover:text-cian transition-colors">{l.migas}</a>
          <span aria-hidden="true" class="mx-2 text-cian/60">/</span>
          <span aria-current="page" class="text-white/80">{x.nombre}</span>
        </nav>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-8 items-end">
          <div class="lg:col-span-7" data-reveal>
            <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-white/60 mb-6">{x.nombre}</p>
            <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05]">{x.h1}</h1>
          </div>
          <div class="lg:col-span-5 lg:pb-2 space-y-4 border-l-2 border-cian/30 pl-5" data-reveal style="--reveal-delay: 120ms">
            {x.intro.map((parrafo) => <p class="text-white/75 text-base sm:text-lg leading-relaxed">{parrafo}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-crema text-grafito py-16 sm:py-24">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-5" data-reveal>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy tracking-tight mb-6">{l.problemas}</h2>
          <ul class="space-y-4">
            {x.problemas.map((linea) => (
              <li class="flex gap-3 text-base leading-relaxed">
                <span class="mt-2.5 h-px w-5 shrink-0 bg-cian-dark" aria-hidden="true"></span>
                <span>{linea}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="lg:col-span-7" data-reveal style="--reveal-delay: 120ms">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy tracking-tight mb-6">{l.comoAyuda}</h2>
          <ol class="border-t border-navy/15">
            {x.comoAyuda.map((punto, i) => (
              <li class="flex items-baseline gap-5 border-b border-navy/15 py-4">
                <span class="font-mono text-sm font-bold text-navy/60 tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
                <span>
                  <span class="block text-base sm:text-lg font-semibold text-navy">{punto.titulo}</span>
                  <span class="block text-sm sm:text-base text-grafito/80 mt-1">{punto.texto}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/* Ejemplo de conversacion: marcado como ejemplo, con datos inventados. */}
    <section class="bg-navy py-16 sm:py-24 border-t border-white/10">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-3">{l.ejemplo}</h2>
        <p class="text-sm text-white/60 mb-8">{l.ejemploAviso}</p>
        <ol class="space-y-3" aria-label={l.ejemplo}>
          {x.chat.map((m) => (
            <li class={m.de === 'cliente' ? 'flex justify-end' : 'flex justify-start'}>
              <p
                class={m.de === 'cliente'
                  ? 'max-w-[85%] rounded-2xl rounded-br-sm bg-white/10 px-4 py-3 text-white/90 leading-relaxed'
                  : 'max-w-[85%] rounded-2xl rounded-bl-sm border border-cian/30 bg-cian/10 px-4 py-3 text-white leading-relaxed'}
              >
                <span class="block font-mono text-[11px] font-bold uppercase tracking-widest text-white/50 mb-1">
                  {m.de === 'cliente' ? l.cliente_tu : l.agente}
                </span>
                {m.texto}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {cliente && (
      <section class="bg-crema text-grafito py-16 sm:py-20">
        <figure class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
          <figcaption class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-navy/60 mb-4">
            {l.cliente} {cliente.name}
          </figcaption>
          <blockquote lang={idioma === 'es' ? undefined : 'es'}>
            <p class="font-display text-xl sm:text-2xl font-medium leading-snug tracking-tight text-navy">&ldquo;{cliente.frase}&rdquo;</p>
          </blockquote>
          {traduccion && (
            <p class="mt-5 text-sm leading-relaxed text-grafito/80">
              <span class="mr-1.5 font-bold text-navy">{t.clientes.etiquetaTraduccion}</span>
              {traduccion}
            </p>
          )}
        </figure>
      </section>
    )}

    <section class="bg-navy-900 py-16 sm:py-24 border-t border-white/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight mb-8" data-reveal>{l.preguntas}</h2>
        <div class="border-t border-white/10">
          {x.preguntas.map((p) => (
            <details class="group border-b border-white/10">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                <h3 class="text-base sm:text-lg font-bold text-white">{p.question}</h3>
                <span class="mt-1 font-mono text-cian transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="pb-6 text-white/75 leading-relaxed">{p.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-navy-950 py-16 sm:py-20 border-t border-white/10">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-white/60 mb-6">{l.otros}</h2>
        <ul class="border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 gap-x-8 sm:gap-x-14">
          {otros.map((s) => (
            <li class="border-b border-white/10">
              <a href={ruta(rutaSector(s.slug), idioma)} class="group flex items-baseline gap-4 py-5">
                <span class="text-lg sm:text-xl font-extrabold text-white tracking-tight group-hover:text-cian transition-colors">
                  {s.texto[idioma].nombre}
                </span>
                <span class="ml-auto shrink-0 text-cian opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <CtaContacto titulo={l.cta.titulo} texto={l.cta.texto} cta={l.cta.cta} idioma={idioma} />
  </main>

  <Footer idioma={idioma} />
</Layout>
