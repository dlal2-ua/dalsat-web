---
// Pagina /seguridad (y /en/seguridad). Compartida entre idiomas: los textos
// viven en data/seguridad.ts. Misma gramatica visual que las paginas de sector.
import Layout from '../layouts/Layout.astro';
import Header from './Header';
import Footer from './Footer';
import CtaContacto from './CtaContacto.astro';
import { SEGURIDAD } from '../data/seguridad';
import { ruta, type Idioma } from '../i18n/config';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
const x = SEGURIDAD[idioma];
---

<Layout title={x.seoTitulo} description={x.seoDescripcion}>
  <Header client:load currentPath="/seguridad" idioma={idioma} />

  <main id="contenido" class="pt-16">
    <section class="relative py-16 sm:py-24 bg-navy-900 overflow-hidden bg-[radial-gradient(ellipse_55%_60%_at_0%_0%,rgba(20,205,236,0.14),transparent_70%)]">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-8 items-end">
        <div class="lg:col-span-7" data-reveal>
          <p class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-white/60 mb-6">{x.etiqueta}</p>
          <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05]">{x.h1}</h1>
        </div>
        <p class="lg:col-span-5 lg:pb-2 border-l-2 border-cian/30 pl-5 text-white/75 text-base sm:text-lg leading-relaxed" data-reveal style="--reveal-delay: 120ms">
          {x.intro}
        </p>
      </div>
    </section>

    <section class="bg-crema text-grafito py-16 sm:py-24">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
        <ol class="border-t border-navy/15">
          {x.bloques.map((b, i) => (
            <li class="flex items-baseline gap-5 border-b border-navy/15 py-6">
              <span class="font-mono text-sm font-bold text-navy/60 tabular-nums shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <h2 class="block text-lg sm:text-xl font-semibold text-navy">{b.titulo}</h2>
                <p class="mt-1 text-base text-grafito/80 leading-relaxed">{b.texto}</p>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="bg-navy-950 py-16 sm:py-20 border-t border-white/10">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8" data-reveal>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-6">{x.limitesTitulo}</h2>
        <ul class="space-y-4">
          {x.limites.map((linea) => (
            <li class="flex gap-3 text-base leading-relaxed text-white/75">
              <span class="mt-2.5 h-px w-5 shrink-0 bg-cian" aria-hidden="true"></span>
              <span>{linea}</span>
            </li>
          ))}
        </ul>
        <p class="mt-8 text-white/75">
          {x.privacidadTexto}
          <a href={ruta('/politica-privacidad', idioma)} class="text-cian underline underline-offset-4 hover:text-white transition-colors">{x.privacidadEnlace}</a>.
        </p>
      </div>
    </section>

    <CtaContacto titulo={x.cta.titulo} texto={x.cta.texto} cta={x.cta.cta} idioma={idioma} />
  </main>

  <Footer idioma={idioma} />
</Layout>
