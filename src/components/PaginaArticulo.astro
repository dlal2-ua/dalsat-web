---
// Un articulo de /recursos. Recibe la entrada ya filtrada (publicada y del
// idioma de la ruta) desde getStaticPaths.
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from './Header';
import Footer from './Footer';
import CtaContacto from './CtaContacto.astro';
import { contenido } from '../i18n';
import { ruta, type Idioma } from '../i18n/config';

interface Props {
  idioma: Idioma;
  articulo: CollectionEntry<'blog'>;
}

const { idioma, articulo } = Astro.props;
const t = contenido(idioma);
const { Content } = await render(articulo);
const SITE = Astro.site ?? new URL('https://dalsats.com');
const url = new URL(ruta(`/recursos/${articulo.id}`, idioma), SITE).toString();
const fecha = new Intl.DateTimeFormat(idioma === 'es' ? 'es-ES' : 'en-GB', { dateStyle: 'long' });

const schemaArticulo = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articulo.data.title,
  description: articulo.data.description,
  datePublished: articulo.data.date.toISOString(),
  inLanguage: idioma === 'es' ? 'es-ES' : 'en',
  mainEntityOfPage: url,
  author: { '@id': new URL('/#organizacion', SITE).toString() },
  publisher: { '@id': new URL('/#organizacion', SITE).toString() },
};
---

<Layout title={`${articulo.data.title} | DALSAT`} description={articulo.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaArticulo)} />
  <Header client:load currentPath="/recursos" idioma={idioma} />
  <main id="contenido" class="pt-16">
    <article class="bg-crema text-grafito py-16 sm:py-24">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <nav aria-label={t.recursos.titulo} class="mb-8 text-xs font-mono text-navy/60">
          <a href={ruta('/recursos', idioma)} class="hover:text-navy transition-colors">{t.recursos.titulo}</a>
        </nav>
        <time datetime={articulo.data.date.toISOString()} class="font-mono text-xs text-navy/60">{fecha.format(articulo.data.date)}</time>
        <h1 class="mt-2 text-3xl sm:text-5xl font-extrabold text-navy tracking-tight leading-tight">{articulo.data.title}</h1>
        <div class="articulo mt-10 space-y-5 text-base sm:text-lg leading-relaxed">
          <Content />
        </div>
      </div>
    </article>
    <CtaContacto
      titulo={t.cierreContacto.servicios.titulo}
      texto={t.cierreContacto.servicios.texto}
      cta={t.cierreContacto.servicios.cta}
      idioma={idioma}
    />
  </main>
  <Footer idioma={idioma} />
</Layout>

<style>
  /* navy de tailwind.config.mjs */
  .articulo :global(h2) { font-size: 1.5rem; font-weight: 800; color: #072847; margin-top: 2.5rem; }
  .articulo :global(ul) { list-style: disc; padding-left: 1.25rem; }
  .articulo :global(li + li) { margin-top: 0.5rem; }
  .articulo :global(a) { text-decoration: underline; text-underline-offset: 3px; }
</style>
