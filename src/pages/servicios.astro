---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import ServiceTabs from '../components/ServiceTabs';
import StepScroll from '../components/StepScroll';
import Footer from '../components/Footer';
---

<Layout
  title="Servicios de Automatización IA — Dalsat"
  description="Descubre los agentes de IA de Dalsat: atención en WhatsApp, gestión de recordatorios y escalado inteligente a humano."
>
  <Header client:load currentPath="/servicios" />

  <main class="pt-16">
    {/* Banner introductorio de servicios */}
    <section class="relative py-16 sm:py-24 bg-gradient-to-b from-[#001026] via-[#000A18] to-[#000814] overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-[#00E0FF]/15 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#00E0FF] border border-[#00E0FF]/30 bg-[#00E0FF]/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(0,224,255,0.2)] mb-4">
          Nuestras Soluciones
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Soluciones de IA Adaptadas a Tu Negocio
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-light max-w-3xl mx-auto">
          Automatiza la atención de tus clientes 24/7 sin perder el toque humano ni la cercanía de tu empresa.
        </p>
      </div>
    </section>

    {/* Centro de Mando de Servicios */}
    <ServiceTabs client:load />

    {/* Proceso en 3 Pasos */}
    <StepScroll client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-[#000814] border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          ¿Listo para automatizar tu negocio?
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Configuramos tu agente de IA a medida en cuestión de días. Sin complicaciones.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-[#00E0FF] hover:bg-white text-[#001A3F] font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(0,224,255,0.4)] hover:scale-105"
        >
          Solicitar demostración sin compromiso →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
