---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Services from '../components/Services';
import Platform from '../components/Platform';
import StepScroll from '../components/StepScroll';
import FaqSection from '../components/FaqSection';
import Footer from '../components/Footer';
---

<Layout
  title="Servicios | SaaS a medida, agentes de IA, automatización, SEO y web"
  description="Los seis servicios de DALSAT para pymes de toda España: programas a medida, agentes de IA por WhatsApp, Instagram y web, panel de gestión, mapeo y automatización de procesos, SEO y desarrollo web."
>
  <Header client:load currentPath="/servicios" />

  <main class="pt-16">
    {/* Banner introductorio de servicios */}
    <section class="relative py-16 sm:py-24 bg-gradient-to-b from-navy-800 via-navy-950 to-navy-900 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(20,205,236,0.2)] mb-4">
          Qué hacemos
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Seis formas de quitarte trabajo de encima
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-light max-w-3xl mx-auto">
          No hace falta hacerlo todo a la vez. Empezamos por lo que más te pesa cada semana y seguimos desde ahí.
        </p>
      </div>
    </section>

    {/* Catálogo completo, en orden de prioridad */}
    <Services />

    {/* El panel desde el que se gestiona todo */}
    <Platform />

    {/* Proceso en 3 Pasos */}
    <StepScroll client:load />

    {/* Preguntas Frecuentes */}
    <FaqSection client:visible />

    {/* CTA de Contacto */}
    <section class="py-20 bg-navy-900 border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          ¿Por dónde empezarías tú?
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Cuéntanos cómo trabajas hoy y te decimos qué se puede quitar de en medio. Sin compromiso.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-terracota hover:bg-terracota-dark text-white font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(217,100,44,0.4)] hover:scale-105"
        >
          Habla con nosotros →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
