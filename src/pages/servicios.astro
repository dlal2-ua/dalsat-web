---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Services from '../components/Services';
import Platform from '../components/Platform';
import StepScroll from '../components/StepScroll';
import FaqSection from '../components/FaqSection';
import Footer from '../components/Footer';
---

<Layout
  title="Servicios | SaaS a medida, agentes de IA, automatización, SEO y web"
  description="Los seis servicios de DALSAT para pymes de toda España: programas a medida, agentes de IA por WhatsApp, Instagram y web, panel de gestión, mapeo y automatización de procesos, SEO y desarrollo web."
>
  <Header client:load currentPath="/servicios" />

  <main class="pt-16">
    {/* Portada del catalogo. Esta pagina es un indice de seis piezas
        numeradas, asi que abre como un indice: numero, regla y titulo a la
        izquierda, entradilla descolgada a la derecha. El resto del sitio abre
        con badge + titulo centrado; aqui no, para que se note que entras en
        otra cosa. El badge decia "Que hacemos" y el h1 lo repetia. */}
    <section class="relative py-16 sm:py-28 bg-gradient-to-b from-navy-800 via-navy-950 to-navy-900 overflow-hidden">
      <div class="absolute top-0 -left-40 w-[620px] h-[420px] bg-cian/15 rounded-full blur-[160px] pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-8 items-end">
          <div class="lg:col-span-7" data-reveal>
            <div class="flex items-center gap-4 mb-6 sm:mb-8">
              <span class="font-mono text-sm font-bold text-cian tabular-nums">06</span>
              <span class="h-px flex-1 max-w-[7rem] bg-cian/30" aria-hidden="true"></span>
              <span class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-white/40">
                Servicios
              </span>
            </div>
            <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05]">
              Seis formas de quitarte trabajo de encima
            </h1>
          </div>

          <p class="lg:col-span-5 lg:pb-2 text-white/70 text-base sm:text-lg font-light leading-relaxed border-l-2 border-cian/30 pl-5" data-reveal style="--reveal-delay: 120ms">
            No hace falta hacerlo todo a la vez. Empezamos por lo que más te pesa cada semana y seguimos desde ahí.
          </p>
        </div>
      </div>
    </section>

    {/* Catálogo completo, en orden de prioridad */}
    <Services />

    {/* El panel desde el que se gestiona todo */}
    <Platform />

    {/* Proceso en 3 Pasos */}
    <StepScroll client:load />

    {/* Preguntas Frecuentes */}
    <FaqSection client:visible />

    {/* CTA de Contacto */}
    <section class="py-20 bg-navy-900 border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          ¿Por dónde empezarías tú?
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Cuéntanos cómo trabajas hoy y te decimos qué se puede quitar de en medio. Sin compromiso.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-terracota hover:bg-terracota-dark text-navy font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(217,100,44,0.4)] hover:scale-105"
        >
          Habla con nosotros →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
