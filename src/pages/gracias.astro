---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { urlWhatsApp } from '../data/contacto';

const WHATSAPP_URL = urlWhatsApp('Hola, acabo de escribiros por el formulario de la web.');

// Mientras esperan, algo que mirar. Nada de esto pide otro formulario.
const MIENTRAS = [
  { href: '/demos', titulo: 'Prueba un agente', texto: 'Escríbele como si fueras un cliente tuyo y mira cómo contesta.' },
  { href: '/calculadora', titulo: 'Calcula tu ahorro', texto: 'Cuántas horas te lleva hoy atender mensajes y llamadas.' },
  { href: '/faq', titulo: 'Preguntas frecuentes', texto: 'Precios, plazos, permanencia y protección de datos.' },
];
---

<Layout
  title="Mensaje enviado | DALSAT"
  description="Hemos recibido tu mensaje. Te contestamos en menos de 24 horas laborables."
  noindex={true}
>
  <Header client:load currentPath="/gracias" />

  <main class="pt-16">
    <section class="relative min-h-[calc(100vh-64px)] flex items-center bg-gradient-to-b from-navy-950 via-navy-800 to-navy-900 py-16 sm:py-24 border-t border-white/10 overflow-hidden">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"
        aria-hidden="true"
      ></div>
      <div
        class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[150px] pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center rounded-2xl border border-cian/40 bg-cian/15 text-cian">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
          Mensaje recibido
        </h1>
        <p class="text-white/75 text-base sm:text-lg max-w-xl mx-auto mb-3">
          Te contestamos en menos de 24 horas laborables, y lo hace quien va a llevar tu proyecto, no
          un comercial.
        </p>
        <p class="text-white/55 text-sm max-w-xl mx-auto mb-10">
          Si es urgente, escríbenos por WhatsApp y lo vemos antes.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-14">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center bg-terracota hover:bg-terracota-dark text-navy font-extrabold text-sm px-8 py-4 rounded-2xl transition-all shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-105"
          >
            Escribirnos por WhatsApp
          </a>
          <a
            href="/"
            class="w-full sm:w-auto inline-flex items-center justify-center border border-cian/40 bg-cian/10 text-cian hover:bg-cian/20 hover:text-white font-bold text-sm px-8 py-4 rounded-2xl transition-colors"
          >
            Volver al inicio
          </a>
        </div>

        <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">
          Mientras tanto
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left">
          {MIENTRAS.map((m) => (
            <a
              href={m.href}
              class="group rounded-2xl border border-white/12 bg-white/[0.04] p-5 transition-all hover:border-cian/50 hover:bg-white/[0.07]"
            >
              <span class="block text-white font-bold text-sm mb-1 group-hover:text-cian transition-colors">
                {m.titulo}
              </span>
              <span class="block text-white/60 text-xs leading-relaxed">{m.texto}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
