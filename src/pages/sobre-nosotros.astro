---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import AboutUs from '../components/AboutUs';
import Footer from '../components/Footer';
---

<Layout
  title="Sobre Nosotros — Dalsat"
  description="Conoce al equipo de Dalsat y nuestra visión para hacer la inteligencia artificial accesible a cualquier negocio."
>
  <Header client:load currentPath="/sobre-nosotros" />

  <main class="pt-16">
    {/* Componente Quiénes Somos */}
    <AboutUs client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-[#000814] border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Trabaja con el equipo de Dalsat
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Acompañamiento cercano y soporte continuo para que tu empresa saque el máximo partido a la IA.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-[#00E0FF] hover:bg-white text-[#001A3F] font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(0,224,255,0.4)] hover:scale-105"
        >
          Contactar con nuestro equipo →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
