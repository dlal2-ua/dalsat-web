---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import AboutUs from '../components/AboutUs';
import Footer from '../components/Footer';
import CtaContacto from '../components/CtaContacto.astro';
---

<Layout
  title="Sobre nosotros | DALSAT"
  description="Quiénes somos: un estudio de digitalización que trabaja con pymes de toda España."
>
  <Header client:load currentPath="/sobre-nosotros" />

  <main class="pt-16">
    {/* Componente Quiénes Somos */}
    <AboutUs client:load />

    <CtaContacto
      titulo="Trabaja con nosotros"
      texto="Te acompañamos desde el primer día y seguimos encima cuando ya está funcionando."
      cta="Habla con nosotros"
    />

  </main>

  <Footer client:visible />
</Layout>
