---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import AboutUs from '../components/AboutUs';
import Footer from '../components/Footer';
---

<Layout
  title="Sobre nosotros | DALSAT"
  description="Quiénes somos: un estudio de digitalización que trabaja con pymes de Alicante y Murcia."
>
  <Header client:load currentPath="/sobre-nosotros" />

  <main class="pt-16">
    {/* Componente Quiénes Somos */}
    <AboutUs client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-navy-900 border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Trabaja con nosotros
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Te acompañamos desde el primer día y seguimos encima cuando ya está funcionando.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-terracota hover:bg-terracota-dark text-white font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(20,205,236,0.4)] hover:scale-105"
        >
          Habla con nosotros →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
