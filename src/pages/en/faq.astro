---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import FaqSection from '../../components/FaqSection';
import Footer from '../../components/Footer';
import { contenido } from '../../i18n';
import { schemaFaq } from '../../data/schemaFaq';

const schema = schemaFaq(contenido('en').faq.items, 'en');
---

<Layout
  title="Frequently asked questions | DALSAT"
  description="Common questions about DALSAT: where to start, what it costs, timelines, custom software, AI agents, the AI-powered CRM, automation, SEO and websites."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header client:load currentPath="/faq" idioma="en" />

  <main id="contenido" class="pt-16">
    <FaqSection client:idle idioma="en" />
  </main>

  <Footer idioma="en" />
</Layout>
