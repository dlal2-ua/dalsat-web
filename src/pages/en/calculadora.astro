---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import RoiCalculator from '../../components/RoiCalculator';
import Footer from '../../components/Footer';
import CtaContacto from '../../components/CtaContacto.astro';
---

<Layout
  title="Savings calculator | DALSAT"
  description="Work out how many hours a month you get back by automating the messages and calls your business handles by hand."
>
  <Header client:load currentPath="/calculadora" idioma="en" />

  <main class="pt-16">
    {/* Abre como una hoja de calculo: que entra y que sale, en mono. */}
    <section class="relative py-16 sm:py-24 bg-gradient-to-b from-navy-800 via-navy-950 to-navy-900 overflow-hidden">
      <div class="absolute bottom-0 right-0 w-[560px] h-[400px] bg-cian-dark/15 rounded-full blur-[160px] pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="max-w-3xl" data-reveal>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-white/40 pb-5 mb-7 border-b border-white/10">
            <span>In</span>
            <span class="text-white/70">your week</span>
            <span class="text-cian-dark" aria-hidden="true">&rarr;</span>
            <span>Out</span>
            <span class="text-cian">hours and euros a month</span>
          </p>
          <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05] mb-5">
            What is doing it by hand costing you?
          </h1>
          <p class="text-white/70 text-base sm:text-lg font-light leading-relaxed max-w-2xl">
            Move the controls and come out with a figure: the hours your team gets back each month and what that is worth.
          </p>
        </div>
      </div>
    </section>

    <RoiCalculator client:load idioma="en" />

    <CtaContacto
      titulo="Do the numbers add up for you?"
      texto="We look at your particular case and tell you what can be automated and what is not worth the trouble."
      cta="Talk to us"
    />
  </main>

  <Footer client:visible idioma="en" />
</Layout>
