---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Services from '../../components/Services';
import Platform from '../../components/Platform';
import Combinaciones from '../../components/Combinaciones.astro';
import StepScroll from '../../components/StepScroll';
import Footer from '../../components/Footer';
import CtaContacto from '../../components/CtaContacto.astro';
---

<Layout
  title="Custom software and AI agents for small businesses | DALSAT"
  description="Custom software, AI agents for WhatsApp, an AI-powered CRM, process mapping, SEO and web development: DALSAT's six services for small businesses in Spain."
>
  <Header client:load currentPath="/servicios" idioma="en" />

  <main id="contenido" class="pt-16">
    {/* Misma portada de indice que la version en castellano: numero, regla y
        titulo a la izquierda, entradilla descolgada a la derecha. */}
    <section class="relative py-16 sm:py-28 bg-gradient-to-b from-navy-800 via-navy-950 to-navy-900 overflow-hidden">
      <div class="absolute inset-0 pointer-events-none bg-[radial-gradient(circle_at_10%_0%,rgba(20,205,236,0.14),transparent_60%)]" aria-hidden="true"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-8 gap-y-8 items-end">
          <div class="lg:col-span-7" data-reveal>
            <div class="flex items-center gap-4 mb-6 sm:mb-8">
              <span class="font-mono text-sm font-bold text-cian tabular-nums">06</span>
              <span class="h-px flex-1 max-w-[7rem] bg-cian/30" aria-hidden="true"></span>
              <span class="font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-white/60">
                Services
              </span>
            </div>
            <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05]">
              Six ways to take work off your hands
            </h1>
          </div>

          <p
            class="lg:col-span-5 lg:pb-2 text-white/70 text-base sm:text-lg font-light leading-relaxed border-l-2 border-cian/30 pl-5"
            data-reveal
            style="--reveal-delay: 120ms"
          >
            You do not have to do it all at once: take them one by one or combined. We start with whatever weighs on you most each week and go from there.
          </p>
        </div>
      </div>
    </section>

    <Services idioma="en" />
    <Combinaciones idioma="en" />
    <Platform idioma="en" />
    <StepScroll idioma="en" />

    <CtaContacto
      titulo="Where would you start?"
      texto="Tell us how you work today and we will tell you what can be taken off your hands. No strings attached."
      cta="Talk to us"
    />
  </main>

  <Footer idioma="en" />
</Layout>
