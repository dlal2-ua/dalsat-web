---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import { urlWhatsApp } from '../../data/contacto';

const WHATSAPP_URL =
  urlWhatsApp('Hi, I have just written to you through the form on the site.');

// Mientras esperan, algo que mirar. Nada de esto pide otro formulario.
const MEANWHILE = [
  {
    href: '/en/demos',
    titulo: 'Try an agent',
    texto: 'Write to it as if you were one of your own customers and see how it answers.',
  },
  {
    href: '/en/calculadora',
    titulo: 'Work out your saving',
    texto: 'How many hours answering messages and calls takes you today.',
  },
  {
    href: '/en/faq',
    titulo: 'Frequently asked questions',
    texto: 'Prices, timelines, minimum terms and data protection.',
  },
];
---

<Layout
  title="Message sent | DALSAT"
  description="We have your message. We reply within 24 working hours."
  noindex={true}
>
  <Header client:load currentPath="/gracias" idioma="en" />

  <main class="pt-16">
    <section class="relative min-h-[calc(100vh-64px)] flex items-center bg-gradient-to-b from-navy-950 via-navy-800 to-navy-900 py-16 sm:py-24 border-t border-white/10 overflow-hidden">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none"
        aria-hidden="true"
      ></div>
      <div
        class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[150px] pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <div class="mx-auto mb-7 flex h-16 w-16 items-center justify-center rounded-2xl border border-cian/40 bg-cian/15 text-cian">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
          </svg>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
          Message received
        </h1>
        <p class="text-white/75 text-base sm:text-lg max-w-xl mx-auto mb-3">
          We reply within 24 working hours, and it is the person who will run your project who
          replies, not a salesperson.
        </p>
        <p class="text-white/55 text-sm max-w-xl mx-auto mb-10">
          If it is urgent, message us on WhatsApp and we will look at it sooner.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 mb-14">
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center bg-terracota hover:bg-terracota-dark text-navy font-extrabold text-sm px-8 py-4 rounded-2xl transition-all shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-105"
          >
            Message us on WhatsApp
          </a>
          <a
            href="/en"
            class="w-full sm:w-auto inline-flex items-center justify-center border border-white/20 text-white font-bold text-sm px-8 py-4 rounded-2xl transition-colors hover:border-cian/50 hover:text-cian"
          >
            Back to home
          </a>
        </div>

        <div class="text-left">
          <p class="mb-4 font-mono text-[11px] font-bold uppercase tracking-[0.2em] text-white/40">
            In the meantime
          </p>
          <ul class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {MEANWHILE.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group block h-full rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-cian/40"
                >
                  <span class="block text-sm font-bold text-white group-hover:text-cian transition-colors">
                    {item.titulo}
                  </span>
                  <span class="mt-1.5 block text-xs leading-relaxed text-white/60">
                    {item.texto}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer client:visible idioma="en" />
</Layout>
