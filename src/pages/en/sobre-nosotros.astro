---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import AboutUs from '../../components/AboutUs';
import CtaContacto from '../../components/CtaContacto.astro';
import Footer from '../../components/Footer';
---

<Layout
  title="About us | DALSAT"
  description="Who we are: a digitalisation studio helping small businesses across Spain automate processes and respond to customers with artificial intelligence."
>
  <Header client:load currentPath="/sobre-nosotros" idioma="en" />

  <main id="contenido" class="pt-16">
    <AboutUs idioma="en" />

    <CtaContacto
      titulo="Shall we talk about your business?"
      texto="We are with you from day one and we stay on it once it is running."
      cta="Talk to us"
    />
  </main>

  <Footer idioma="en" />
</Layout>
