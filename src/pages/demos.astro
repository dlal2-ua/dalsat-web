---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import SectorDemos from '../components/SectorDemos';
import AudioDemos from '../components/AudioDemos';
import Footer from '../components/Footer';
---

<Layout
  title="Demos de agentes de IA por sector | DALSAT"
  description="Prueba un agente de IA de DALSAT hecho para tu tipo de negocio y escucha cómo suena por teléfono en español."
>
  <Header client:load currentPath="/demos" />

  <main class="pt-16">
    {/* Portada de demos. Lo que importa esta debajo: los simuladores. Asi que
        la portada se aparta (mas baja, sin badge) y lo unico que anade es un
        punto vivo que avisa de que esto se toca. Centrada a proposito, para
        contrastar con la portada de /servicios, que va alineada a izquierda. */}
    <section class="relative py-14 sm:py-20 bg-gradient-to-b from-navy-800 via-navy-950 to-navy-900 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[160px] pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center" data-reveal>
        <p class="flex items-center justify-center gap-2.5 font-mono text-[11px] font-bold uppercase tracking-[0.22em] text-white/45 mb-6">
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cian opacity-70"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-cian"></span>
          </span>
          Servicio 02 · Agentes de IA
        </p>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-[1.05] mb-5 max-w-4xl mx-auto">
          Prueba un agente hecho para tu tipo de negocio
        </h1>
        <p class="text-white/70 text-base sm:text-lg font-light max-w-2xl mx-auto">
          Escribe al agente como si fueras un cliente, o escucha cómo suena por teléfono. Los agentes son uno de los seis servicios.
        </p>
      </div>
    </section>

    {/* Demos por Sector */}
    <SectorDemos client:load />

    {/* Demos de Voz IA */}
    <AudioDemos client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-navy-900 border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          ¿Y con los datos de tu negocio?
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Te preparamos una prueba gratis con tus servicios, tus precios y tu forma de hablar.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-terracota hover:bg-terracota-dark text-navy font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(217,100,44,0.35)] hover:scale-105"
        >
          Pedir una prueba con mis datos →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
