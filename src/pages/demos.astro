---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import SectorDemos from '../components/SectorDemos';
import AudioDemos from '../components/AudioDemos';
import Footer from '../components/Footer';
---

<Layout
  title="Demos de IA e Interacción en Vivo — Dalsat"
  description="Prueba las demostraciones en vivo por sector y escucha los agentes de voz en español de Dalsat."
>
  <Header client:load currentPath="/demos" />

  <main class="pt-16">
    {/* Banner de Demos */}
    <section class="relative py-16 sm:py-24 bg-gradient-to-b from-[#001026] via-[#000A18] to-[#000814] overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-emerald-500/15 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#25D366] border border-[#25D366]/30 bg-[#25D366]/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(37,211,102,0.2)] mb-4">
          Demostraciones en Directo
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Experimenta la Potencia de Nuestros Agentes
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-light max-w-3xl mx-auto">
          Prueba el chat interactivo ajustado a tu sector o escucha las muestras de voz realistas en español.
        </p>
      </div>
    </section>

    {/* Demos por Sector */}
    <SectorDemos client:load />

    {/* Demos de Voz IA */}
    <AudioDemos client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-[#000814] border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          ¿Quieres una prueba personalizada con tu propia marca?
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Te preparamos una demostración gratuita entrenada con los servicios reales de tu empresa.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-[#25D366] hover:bg-white text-[#001A3F] font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(37,211,102,0.4)] hover:scale-105"
        >
          Probar con los datos de mi negocio →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
