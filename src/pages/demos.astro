---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import SectorDemos from '../components/SectorDemos';
import AudioDemos from '../components/AudioDemos';
import Footer from '../components/Footer';
---

<Layout
  title="Demos de agentes de IA por sector | DALSAT"
  description="Prueba un agente de IA de DALSAT hecho para tu tipo de negocio y escucha cómo suena por teléfono en español."
>
  <Header client:load currentPath="/demos" />

  <main class="pt-16">
    {/* Banner de Demos */}
    <section class="relative py-16 sm:py-24 bg-gradient-to-b from-navy-800 via-navy-950 to-navy-900 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(37,211,102,0.2)] mb-4">
          Servicio 02 · Agentes de IA
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Prueba un agente hecho para tu tipo de negocio
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-light max-w-3xl mx-auto">
          Escribe al agente como si fueras un cliente, o escucha cómo suena por teléfono. Los agentes son uno de los cinco servicios.
        </p>
      </div>
    </section>

    {/* Demos por Sector */}
    <SectorDemos client:load />

    {/* Demos de Voz IA */}
    <AudioDemos client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-navy-900 border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          ¿Y con los datos de tu negocio?
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Te preparamos una prueba gratis con tus servicios, tus precios y tu forma de hablar.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-terracota hover:bg-terracota-dark text-white font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(217,100,44,0.35)] hover:scale-105"
        >
          Pedir una prueba con mis datos →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
