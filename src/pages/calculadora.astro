---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import RoiCalculator from '../components/RoiCalculator';
import Footer from '../components/Footer';
---

<Layout
  title="Calculadora de Ahorro y ROI — Dalsat"
  description="Calcula cuánto tiempo y dinero ahorrará tu empresa al automatizar la atención al cliente con agentes de IA."
>
  <Header client:load currentPath="/calculadora" />

  <main class="pt-16">
    {/* Banner de Calculadora */}
    <section class="relative py-16 sm:py-24 bg-gradient-to-b from-[#001026] via-[#000A18] to-[#000814] overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-purple-500/15 rounded-full blur-[160px] pointer-events-none"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10 text-center">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#7C6BD6] border border-[#7C6BD6]/30 bg-[#7C6BD6]/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(124,107,214,0.2)] mb-4">
          Retorno de Inversión
        </span>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Calcula tu Ahorro Mensual
        </h1>
        <p class="text-white/70 text-base sm:text-xl font-light max-w-3xl mx-auto">
          Mueve los controles para estimar las horas libres que ganará tu equipo y el coste económico optimizado.
        </p>
      </div>
    </section>

    {/* Calculadora de ROI */}
    <RoiCalculator client:load />

    {/* CTA de Contacto */}
    <section class="py-20 bg-[#000814] border-t border-white/10 text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-4">
          Empieza a ahorrar tiempo desde esta misma semana
        </h2>
        <p class="text-white/70 text-base sm:text-lg mb-8">
          Te entregamos un análisis de ROI detallado para la estructura de tu empresa.
        </p>
        <a
          href="/contacto"
          class="inline-flex bg-gradient-to-r from-[#00E0FF] to-[#7C6BD6] hover:brightness-110 text-[#001A3F] font-extrabold text-base px-8 py-4 rounded-2xl transition-all shadow-[0_0_30px_rgba(0,224,255,0.4)] hover:scale-105"
        >
          Hablar con un consultor de IA →
        </a>
      </div>
    </section>
  </main>

  <Footer client:visible />
</Layout>
