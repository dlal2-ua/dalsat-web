---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import SplitHero from '../components/SplitHero';
import SatisfiedClients from '../components/SatisfiedClients';
import FaqSection from '../components/FaqSection';
import ContactForm from '../components/ContactForm';
import FloatingWhatsApp from '../components/FloatingWhatsApp';
import Footer from '../components/Footer';

const WHATSAPP_URL = 'https://api.whatsapp.com/send?phone=34646005171&text=Hola,%20me%20interesa%20lo%20que%20hac%C3%A9is%20y%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n.';
---

<Layout
  title="Dalsat — Automatización con IA"
  description="Agentes de IA que automatizan tu negocio: WhatsApp, escalado a humano y recordatorios de citas. Sin código, listo en días."
>
  {/* Header Reutilizable Multipágina */}
  <Header client:load currentPath="/" />

  <main>
    {/* 1. HERO GALÁCTICO: SPLIT + CHAT */}
    <SplitHero client:load />

    {/* 2. EMPRESAS SATISFECHAS (CASOS VÍBORA STUDIO & ATRIO ASESORES) */}
    <SatisfiedClients client:load />

    {/* 3. AVANCE DESTACADO DE SERVICIOS */}
    <section class="py-20 bg-navy-900 border-t border-white/10 relative overflow-hidden">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md mb-3">
              Soluciones Inteligentes
            </span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
              ¿Qué puede hacer la IA por tu empresa?
            </h2>
          </div>
          <a
            href="/servicios"
            class="inline-flex items-center gap-2 text-sm font-extrabold text-cian hover:text-white transition-colors"
          >
            Ver catálogo de servicios completo →
          </a>
        </div>

        {/* 3 Tarjetas Resumen */}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white/[0.03] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl hover:border-cian/40 transition-all group">
            <div class="text-3xl mb-4">💬</div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cian transition-colors">
              Atención WhatsApp 24/7
            </h3>
            <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed mb-6">
              Responde automáticamente a consultas, precios y disponibilidades a cualquier hora del día o de la noche.
            </p>
            <a href="/servicios" class="text-xs font-bold text-cian group-hover:underline">
              Saber más →
            </a>
          </div>

          <div class="bg-white/[0.03] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl hover:border-cian-dark/40 transition-all group">
            <div class="text-3xl mb-4">📅</div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cian-dark transition-colors">
              Gestión y Recordatorio de Citas
            </h3>
            <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed mb-6">
              Organiza tu agenda automáticamente y reduce los plantones y ausencias hasta en un 95%.
            </p>
            <a href="/servicios" class="text-xs font-bold text-cian-dark group-hover:underline">
              Saber más →
            </a>
          </div>

          <div class="bg-white/[0.03] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl hover:border-cian/40 transition-all group">
            <div class="text-3xl mb-4">🤝</div>
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-cian transition-colors">
              Escalado Inteligente a Humano
            </h3>
            <p class="text-white/70 text-xs sm:text-sm font-light leading-relaxed mb-6">
              Deriva los casos complejos a tu equipo sin fricción cuando el cliente requiera atención especializada.
            </p>
            <a href="/servicios" class="text-xs font-bold text-cian group-hover:underline">
              Saber más →
            </a>
          </div>
        </div>

      </div>
    </section>

    {/* 4. AVANCE DE DEMOS E IA POR SECTOR */}
    <section class="py-16 sm:py-20 bg-gradient-to-r from-navy-800 via-navy-900 to-navy-800 border-t border-white/10">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white/[0.03] border border-cian/40 rounded-3xl p-8 sm:p-12 backdrop-blur-2xl flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
          <div class="space-y-3 max-w-2xl">
            <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-3.5 py-1 rounded-full inline-block">
              Demostraciones en Vivo
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
              Prueba los Agentes de IA Adaptados a Tu Sector
            </h2>
            <p class="text-white/70 text-sm sm:text-base font-light">
              Tatuajes 💅, Restauración 🍽️, Salud 🏥 y Asesorías 💼. Prueba la simulación interactiva y los agentes de voz en español.
            </p>
          </div>
          <a
            href="/demos"
            class="px-7 py-4 rounded-2xl bg-terracota hover:bg-terracota-dark text-white font-extrabold text-sm transition-all shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-105 shrink-0"
          >
            Ver Demos en Vivo →
          </a>
        </div>
      </div>
    </section>

    {/* 5. AVANCE DE CALCULADORA DE ROI */}
    <section class="py-16 sm:py-20 bg-navy-900 border-t border-white/10">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white/[0.03] border border-cian-dark/40 rounded-3xl p-8 sm:p-12 backdrop-blur-2xl flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
          <div class="space-y-3 max-w-2xl">
            <span class="text-xs font-extrabold uppercase tracking-widest text-cian-dark border border-cian-dark/30 bg-cian-dark/10 px-3.5 py-1 rounded-full inline-block">
              Calculadora de Ahorro
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
              ¿Cuánto puede ahorrar tu empresa al mes?
            </h2>
            <p class="text-white/70 text-sm sm:text-base font-light">
              Calcula las horas libres que ganará tu equipo y la reducción de costes al automatizar las consultas diarias.
            </p>
          </div>
          <a
            href="/calculadora"
            class="px-7 py-4 rounded-2xl bg-terracota hover:bg-terracota-dark text-navy-800 font-extrabold text-sm transition-all shadow-[0_0_25px_rgba(20,205,236,0.4)] hover:scale-105 shrink-0"
          >
            Calcular mi Ahorro →
          </a>
        </div>
      </div>
    </section>

    {/* 6. PREGUNTAS FRECUENTES (FAQ) */}
    <FaqSection client:visible />

    {/* 6. CONTACTO DIRECTO */}
    <section id="contacto" class="relative py-20 sm:py-28 bg-gradient-to-b from-navy-950 via-navy-800 to-navy-900 border-t border-white/10 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>
      
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="text-center mb-10 sm:mb-14">
          <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(20,205,236,0.2)] mb-3">
            Contacto Directo
          </span>
          <h2 class="text-4xl sm:text-6xl font-extrabold text-white mb-3 tracking-tight">
            Empieza hoy
          </h2>
          <p class="text-white/70 text-base sm:text-lg max-w-xl mx-auto">
            Déjanos tus datos o escríbenos por WhatsApp y te mostraremos cómo funcionaría Dalsat en tu negocio.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 bg-white/[0.03] border border-white/10 rounded-3xl p-6 sm:p-10 backdrop-blur-xl shadow-2xl">
            <ContactForm client:load />
          </div>

          <div class="lg:col-span-5 space-y-6">
            <div class="bg-gradient-to-br from-navy-800 to-navy-950 border border-cian/40 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-cian/20 border border-cian/40 flex items-center justify-center text-2xl text-cian">
                💬
              </div>
              <h3 class="text-xl font-bold text-white">
                ¿Prefieres hablar por WhatsApp?
              </h3>
              <p class="text-white/70 text-xs sm:text-sm leading-relaxed">
                Atendemos consultas al instante por WhatsApp de lunes a viernes.
              </p>
              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-4 rounded-2xl bg-terracota hover:bg-terracota-dark text-white font-extrabold text-sm transition-all duration-300 text-center shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-[1.02] block cursor-pointer flex items-center justify-center gap-2"
              >
                Abrir WhatsApp de Dalsat →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FloatingWhatsApp client:load />
  <Footer client:visible />
</Layout>
