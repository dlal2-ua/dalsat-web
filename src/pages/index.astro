---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import SplitHero from '../components/SplitHero';
import SatisfiedClients from '../components/SatisfiedClients';
import Footer from '../components/Footer';
import CtaContacto from '../components/CtaContacto.astro';
import { SERVICIOS, rutaServicio } from '../data/servicios';
import { ruta } from '../i18n';

// Contraste entre lo que ya hizo casi toda pyme y lo que toca ahora
const ANTES = [
  'Una web que enseña quién eres',
  'Perfiles en redes sociales',
  'Ficha en Google Maps',
];

const AHORA = [
  'Un mapa de cómo trabajas de verdad',
  'Lo que se repite cada semana, automatizado',
  'Agentes que atienden y cogen reservas',
];

---

<Layout
  title="Automatización e IA para pymes | DALSAT"
  description="Automatización e IA para pymes de toda España: agentes de IA para WhatsApp, software a medida, CRM con IA y automatización de procesos con DALSAT."
>
  {/* Header Reutilizable Multipágina */}
  <Header client:load currentPath="/" />

  <main id="contenido">
    {/* 1. HERO GALÁCTICO: SPLIT + CHAT */}
    <SplitHero client:load />

