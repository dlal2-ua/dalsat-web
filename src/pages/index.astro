---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import SplitHero from '../components/SplitHero';
import Platform from '../components/Platform';
import SatisfiedClients from '../components/SatisfiedClients';
import FaqSection from '../components/FaqSection';
import ContactForm from '../components/ContactForm';
import FloatingWhatsApp from '../components/FloatingWhatsApp';
import Footer from '../components/Footer';

const WHATSAPP_URL = 'https://api.whatsapp.com/send?phone=34646005171&text=Hola,%20me%20interesa%20lo%20que%20hac%C3%A9is%20y%20me%20gustar%C3%ADa%20recibir%20m%C3%A1s%20informaci%C3%B3n.';

// Contraste entre lo que ya hizo casi toda pyme y lo que toca ahora
const ANTES = [
  'Una web que enseña quién eres',
  'Perfiles en redes sociales',
  'Ficha en Google Maps',
];

const AHORA = [
  'Un mapa de cómo trabajas de verdad',
  'Lo que se repite cada semana, automatizado',
  'Agentes que atienden y cogen reservas',
];

// Los cinco servicios, en orden de prioridad. El catálogo entero vive en /servicios.
const SERVICIOS = [
  {
    n: '01',
    nombre: 'SaaS a medida',
    texto: 'El programa que tu negocio necesita, con lo que usas de verdad y sin lo que sobra.',
    icono: 'M6.75 7.5l3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z',
  },
  {
    n: '02',
    nombre: 'Agentes de IA',
    texto: 'Atienden por WhatsApp, por Instagram o dentro de tu web. Resuelven dudas y cogen reservas.',
    icono: 'M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 20.97a5.969 5.969 0 0 1-.474-.065 4.48 4.48 0 0 0 .978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25Z',
  },
  {
    n: '03',
    nombre: 'Mapeo y automatización',
    texto: 'Dibujamos cómo funciona tu negocio paso a paso y quitamos de en medio lo que se repite.',
    icono: 'M7.5 3.75H6A2.25 2.25 0 0 0 3.75 6v1.5M16.5 3.75H18A2.25 2.25 0 0 1 20.25 6v1.5m0 9V18A2.25 2.25 0 0 1 18 20.25h-1.5m-9 0H6A2.25 2.25 0 0 1 3.75 18v-1.5M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z',
  },
  {
    n: '04',
    nombre: 'SEO',
    texto: 'Que tu negocio salga cuando alguien de tu zona busca en Google lo que tú ofreces.',
    icono: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z',
  },
  {
    n: '05',
    nombre: 'Desarrollo web',
    texto: 'Webs rápidas y claras, pensadas para que quien entre pida cita, escriba o compre.',
    icono: 'M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z',
  },
];
---

<Layout
  title="DALSAT | Re-digitalización de pymes en Alicante y Murcia"
  description="Ya tienes web, redes y Google Maps. Ahora toca automatizar. SaaS a medida, agentes de IA, mapeo de procesos, SEO y desarrollo web para pymes de Alicante y Murcia."
>
  {/* Header Reutilizable Multipágina */}
  <Header client:load currentPath="/" />

  <main>
    {/* 1. HERO GALÁCTICO: SPLIT + CHAT */}
    <SplitHero client:load />

    {/* 2. EMPRESAS SATISFECHAS (CASOS VÍBORA STUDIO & ATRIO ASESORES) */}
    <SatisfiedClients client:load />

    {/* 2.5. RE-DIGITALIZACIÓN: EL MENSAJE CENTRAL */}
    <section id="re-digitalizacion" class="relative bg-navy border-t border-white/10 py-20 sm:py-28 overflow-hidden">
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff03_1px,transparent_1px),linear-gradient(to_bottom,#ffffff03_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-1/4 w-[600px] h-[350px] bg-cian/10 rounded-full blur-[160px] pointer-events-none" aria-hidden="true"></div>

      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl">
          <span class="text-xs font-extrabold uppercase tracking-widest text-cian bg-cian/10 border border-cian/30 px-4 py-1.5 rounded-full inline-block mb-5">
            Re-digitalización
          </span>
          <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
            Ya tienes web, redes y Google Maps. Hoy eso ya no basta.
          </h2>
          <p class="text-white/75 text-base sm:text-lg leading-relaxed mb-4">
            Casi todas las pymes hicieron su primera digitalización hace años. Estuvo bien y sigue haciendo falta. Pero eso ya lo tiene todo el mundo, así que ya no te distingue de nadie.
          </p>
          <p class="text-white/75 text-base sm:text-lg leading-relaxed">
            Lo que viene ahora son procesos que funcionan solos. A eso lo llamamos re-digitalización. No es tener más pantallas: es mirar cómo funciona tu negocio de verdad, dibujarlo paso a paso y automatizar lo que se repite. La inteligencia artificial es una herramienta para ganar tiempo, no una moda.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 mt-12">
          <div class="rounded-3xl p-7 sm:p-9 border border-white/10 bg-white/[0.03]">
            <span class="text-[11px] font-bold uppercase tracking-widest text-white/40 mb-5 inline-block">
              La primera digitalización
            </span>
            <ul class="space-y-3.5">
              {ANTES.map((item) => (
                <li class="flex items-start gap-3 text-white/55 text-sm sm:text-base">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-white/30" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-6 pt-5 border-t border-white/10 text-sm font-semibold text-white/50">
              Sirve para que te vean.
            </p>
          </div>

          <div class="rounded-3xl p-7 sm:p-9 border border-cian/40 bg-gradient-to-b from-cian/[0.08] to-transparent">
            <span class="text-[11px] font-bold uppercase tracking-widest text-cian mb-5 inline-block">
              La re-digitalización
            </span>
            <ul class="space-y-3.5">
              {AHORA.map((item) => (
                <li class="flex items-start gap-3 text-white/85 text-sm sm:text-base">
                  <svg class="mt-0.5 h-5 w-5 shrink-0 text-cian" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <p class="mt-6 pt-5 border-t border-cian/20 text-sm font-semibold text-white">
              Sirve para que te quiten trabajo de encima.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 3. LOS CINCO SERVICIOS (avance; el catálogo completo vive en /servicios) */}
    <section id="servicios" class="py-20 bg-navy-900 border-t border-white/10 relative overflow-hidden">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md mb-3">
              Qué hacemos
            </span>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
              Cinco formas de quitarte trabajo de encima
            </h2>
            <p class="text-white/70 text-base sm:text-lg mt-4 max-w-2xl">
              No hace falta hacerlo todo a la vez. Empezamos por lo que más te pesa cada semana y seguimos desde ahí.
            </p>
          </div>
          <a
            href="/servicios"
            class="inline-flex items-center gap-2 text-sm font-extrabold text-cian hover:text-white transition-colors shrink-0"
          >
            Ver el catálogo completo →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
          {SERVICIOS.map((s) => (
            <article class="bg-white/[0.03] border border-white/10 rounded-3xl p-6 sm:p-8 backdrop-blur-xl hover:border-cian/50 hover:-translate-y-1 transition-all duration-300 group flex flex-col">
              <div class="flex items-center justify-between gap-4 mb-5">
                <div class="p-3 rounded-2xl bg-white/[0.07] border border-white/15 group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-6 h-6 text-cian" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={s.icono} />
                  </svg>
                </div>
                <span class="font-mono text-sm font-bold text-cian/50" aria-hidden="true">{s.n}</span>
              </div>
              <h3 class="text-xl font-bold text-white mb-2.5">
                {s.nombre}
              </h3>
              <p class="text-white/70 text-sm leading-relaxed mb-6">
                {s.texto}
              </p>
              <a href="/servicios" class="mt-auto text-xs font-bold text-cian group-hover:underline self-start">
                Saber más →
              </a>
            </article>
          ))}
        </div>

      </div>
    </section>

    {/* 3.5. LA PLATAFORMA */}
    <Platform />

    {/* 4. AVANCE DE DEMOS E IA POR SECTOR */}
    <section class="py-16 sm:py-20 bg-gradient-to-r from-navy-800 via-navy-900 to-navy-800 border-t border-white/10">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white/[0.03] border border-cian/40 rounded-3xl p-8 sm:p-12 backdrop-blur-2xl flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
          <div class="space-y-3 max-w-2xl">
            <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-3.5 py-1 rounded-full inline-block">
              Servicio 02 · Agentes de IA
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
              Prueba un agente hecho para tu tipo de negocio
            </h2>
            <p class="text-white/70 text-sm sm:text-base font-light">
              Tatuaje, restauración, salud y asesoría. Escribe al agente como si fueras un cliente y escucha cómo suena por teléfono.
            </p>
          </div>
          <a
            href="/demos"
            class="px-7 py-4 rounded-2xl bg-terracota hover:bg-terracota-dark text-white font-extrabold text-sm transition-all shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-105 shrink-0"
          >
            Probar una demo →
          </a>
        </div>
      </div>
    </section>

    {/* 5. AVANCE DE LA CALCULADORA DE AHORRO */}
    <section class="py-16 sm:py-20 bg-navy-900 border-t border-white/10">
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white/[0.03] border border-cian-dark/40 rounded-3xl p-8 sm:p-12 backdrop-blur-2xl flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
          <div class="space-y-3 max-w-2xl">
            <span class="text-xs font-extrabold uppercase tracking-widest text-cian-dark border border-cian-dark/30 bg-cian-dark/10 px-3.5 py-1 rounded-full inline-block">
              Cuentas claras
            </span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
              ¿Cuánto tiempo te está costando hacerlo a mano?
            </h2>
            <p class="text-white/70 text-sm sm:text-base font-light">
              Mueve un par de controles y sal con una cifra: las horas que recuperas al mes y lo que eso vale.
            </p>
          </div>
          <a
            href="/calculadora"
            class="px-7 py-4 rounded-2xl bg-terracota hover:bg-terracota-dark text-white font-extrabold text-sm transition-all shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-105 shrink-0"
          >
            Echar la cuenta →
          </a>
        </div>
      </div>
    </section>

    {/* 6. PREGUNTAS FRECUENTES (FAQ) */}
    <FaqSection client:visible />

    {/* 6. CONTACTO DIRECTO */}
    <section id="contacto" class="relative py-20 sm:py-28 bg-gradient-to-b from-navy-950 via-navy-800 to-navy-900 border-t border-white/10 overflow-hidden">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-cian/15 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>
      
      <div class="max-w-7xl lg:max-w-[1380px] mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="text-center mb-10 sm:mb-14">
          <span class="text-xs font-extrabold uppercase tracking-widest text-cian border border-cian/30 bg-cian/10 px-4 py-1.5 rounded-full inline-block backdrop-blur-md shadow-[0_0_15px_rgba(20,205,236,0.2)] mb-3">
            Contacto
          </span>
          <h2 class="text-4xl sm:text-6xl font-extrabold text-white mb-3 tracking-tight">
            Empieza por lo que más te pese
          </h2>
          <p class="text-white/70 text-base sm:text-lg max-w-xl mx-auto">
            Cuéntanos cómo trabajas hoy. Te decimos qué se puede automatizar, qué no merece la pena y cuánto tiempo te ahorra.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-7 bg-white/[0.03] border border-white/10 rounded-3xl p-6 sm:p-10 backdrop-blur-xl shadow-2xl">
            <ContactForm client:load />
          </div>

          <div class="lg:col-span-5 space-y-6">
            <div class="bg-gradient-to-br from-navy-800 to-navy-950 border border-cian/40 rounded-3xl p-6 sm:p-8 backdrop-blur-xl shadow-2xl space-y-4">
              <div class="w-12 h-12 rounded-2xl bg-cian/20 border border-cian/40 flex items-center justify-center text-cian">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 0 1-.825-.242m9.345-8.334a2.126 2.126 0 0 0-.476-.095 48.64 48.64 0 0 0-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0 0 11.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-white">
                ¿Prefieres hablar por WhatsApp?
              </h3>
              <p class="text-white/70 text-xs sm:text-sm leading-relaxed">
                Atendemos consultas al instante por WhatsApp de lunes a viernes.
              </p>
              <a
                href={WHATSAPP_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-4 rounded-2xl bg-terracota hover:bg-terracota-dark text-white font-extrabold text-sm transition-all duration-300 text-center shadow-[0_0_25px_rgba(217,100,44,0.35)] hover:scale-[1.02] block cursor-pointer flex items-center justify-center gap-2"
              >
                Escríbenos por WhatsApp →
              </a>
              <p class="text-white/45 text-xs text-center">
                Trabajamos con pymes de Alicante y Murcia.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <FloatingWhatsApp client:load />
  <Footer client:visible />
</Layout>
