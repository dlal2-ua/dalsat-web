---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import FaqSection from '../components/FaqSection';
import Footer from '../components/Footer';
import { contenido } from '../i18n';
import { schemaFaq } from '../data/schemaFaq';

const schema = schemaFaq(contenido('es').faq.items, 'es');
---

<Layout
  title="Preguntas frecuentes | DALSAT"
  description="Dudas habituales sobre DALSAT: por dónde se empieza, qué cuesta, plazos, software a medida, agentes de IA, CRM con IA, automatización, SEO y webs."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <Header client:load currentPath="/faq" />

  <main id="contenido" class="pt-16">
    <FaqSection client:load />
  </main>

  <Footer />
</Layout>
