---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import FaqSection from '../components/FaqSection';
import Footer from '../components/Footer';
---

<Layout
  title="Preguntas frecuentes | DALSAT"
  description="Dudas habituales sobre DALSAT: por dónde se empieza, qué cuesta, plazos, programas a medida, agentes de IA, el panel de gestión, automatización, SEO, webs y protección de datos."
>
  <Header client:load currentPath="/faq" />

  <main class="pt-16">
    <FaqSection client:load />
  </main>

  <Footer client:visible />
</Layout>
